{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lectorlab",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  // Sitio estático: Wrangler sube el resultado de `npm run build` (dist/)
  // como assets, sin Worker script ni plugin de Vite.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
