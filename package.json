{
  "name": "lectorlab-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pages": "node scripts/generate-pages.mjs",
    "predev": "npm run pages",
    "dev": "vite --host 0.0.0.0 --port 4173",
    "prebuild": "npm run pages",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "for f in src/*.js src/data/*.js scripts/*.mjs scripts/site/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node tests/notebook.cjs && node tests/catalog.mjs"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  }
}
